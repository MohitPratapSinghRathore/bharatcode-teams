# --- Service ---
NODE_ENV=production
PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgres://teams:CHANGE_ME@localhost:5432/bharatcode_teams
DATABASE_POOL_MAX=10
MIGRATE_ON_START=true
# Web app that hosts /join?invite=... (invite links point here)
PUBLIC_APP_URL=https://bharatcode.ai
# Browser origins allowed to call /v1 (comma-separated)
CORS_ORIGINS=https://bharatcode.ai

# --- Supabase auth (same project as the CLI/Desktop login) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Only if the project still signs JWTs with the legacy HS256 secret; asymmetric keys use JWKS.
# SUPABASE_JWT_SECRET=
REQUIRE_EMAIL_VERIFIED=true
# Used only to read email_confirmed_at (Admin API). Keep it out of every other service.
SUPABASE_SERVICE_ROLE_KEY=
SEAT_COOLDOWN_DAYS=7

# --- Model gateway -> this service (/internal/v1/*). Generate: openssl rand -hex 32 ---
INTERNAL_API_TOKEN=

# --- Razorpay ---
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# UPI Autopay plan: monthly, amount 117882 paise (₹999 + 18% GST per seat). Verified at startup.
RAZORPAY_PLAN_TEAM_PRO_MONTHLY=

# --- GST invoicing (confirm with your CA) ---
SUPPLIER_LEGAL_NAME=Gupta Edtech Solutions Private Limited
SUPPLIER_ADDRESS=
SUPPLIER_GSTIN=
INVOICE_PREFIX=BC
GST_SAC=997331
PAST_DUE_GRACE_DAYS=7
RENEWAL_LEAD_DAYS=10
